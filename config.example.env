# Copy to .env on the server or export in your shell / PaaS dashboard.

# Required for Lovable / browser UI on another origin (comma-separated, no spaces)
CORS_ORIGINS=https://your-app.lovable.app,https://www.yourdomain.com,http://127.0.0.1:5000,http://localhost:5000

# Listen address (use 0.0.0.0 on a VPS)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Keep API downloads inside this folder
DOWNLOAD_ROOT=downloads

# Max upload size for optional cookies file, in MB
MAX_UPLOAD_MB=8

# Many hosts set PORT automatically - use their docs and gunicorn --bind 0.0.0.0:$PORT
